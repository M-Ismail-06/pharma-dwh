          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT captured_at AS time, layer AS metric, sum(size_mb) AS value FROM storage_metrics WHERE layer <> 'warehouse file' AND $__timeFilter(captured_at) GROUP BY 1, 2 ORDER BY 1"
