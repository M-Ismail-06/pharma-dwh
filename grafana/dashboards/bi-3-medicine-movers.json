    {
      "id": 4,
      "type": "table",
      "title": "Fastest and slowest medicine in each therapeutic class",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "staging-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "staging-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH t AS (SELECT therapeutic_class, generic_name, sum(qty_sold_packs) AS packs FROM bi_medicine_month GROUP BY 1, 2), r AS (SELECT *, row_number() OVER (PARTITION BY therapeutic_class ORDER BY packs DESC) AS hi, row_number() OVER (PARTITION BY therapeutic_class ORDER BY packs ASC) AS lo FROM t) SELECT therapeutic_class, max(CASE WHEN hi = 1 THEN generic_name END) AS fastest, max(CASE WHEN hi = 1 THEN packs END) AS fastest_packs, max(CASE WHEN lo = 1 THEN generic_name END) AS slowest, max(CASE WHEN lo = 1 THEN packs END) AS slowest_packs FROM r GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
