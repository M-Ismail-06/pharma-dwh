          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_timestamp(year_month || '-01', 'YYYY-MM-DD') AS time, generic_name AS metric, sum(qty_sold_packs) AS value FROM bi_medicine_month WHERE generic_name IN (SELECT generic_name FROM bi_medicine_month GROUP BY 1 ORDER BY sum(qty_sold_packs) DESC LIMIT 5) GROUP BY 1, 2 ORDER BY 1"
        }
